{
  "builds": [
    {
      "src": "api/create-payment-intent.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/create-payment-intent",
      "dest": "/api/create-payment-intent.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
