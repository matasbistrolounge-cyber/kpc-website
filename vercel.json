{
  "builds": [
    { "src": "api/checkout-session.js", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/checkout", "dest": "/api/checkout-session.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
